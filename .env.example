DATABASE_URL="postgresql://wms:wms@localhost:5432/wms_dev?schema=public"
PORT=4000
NODE_ENV=development
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
CORS_ORIGIN=http://localhost:3000,http://localhost:3001,tauri://localhost,https://tauri.localhost
ERP_WEBHOOK_SECRET=change-me-erp-secret
# Sin configurar: los webhooks salientes quedan en modo stub (solo logean, sin ERP real todavía).
# ERP_WEBHOOK_URL=https://erp.ejemplo.com/webhooks/wms
ERP_WEBHOOK_TIMEOUT_MS=5000
ERP_WEBHOOK_MAX_RETRIES=3
ENFORCE_WEIGHT_LIMITS=false
